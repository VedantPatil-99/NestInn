<% if (hostel.owner) { %>
    <div class="container-lg border-top py-4">
        <h4 class="mb-4">Meet your host</h4>
        <div class="card border-light shadow-sm bg-light rounded-3 p-3">
            <div class="d-flex flex-column align-items-center text-center">
                
                <div class="flex-shrink-0 mb-3 mb-md-0">
                    <img src="/icons/filterIcons/Naruto.jpg" alt="Host Profile Image" 
                        class="rounded-circle border border-3 border-white shadow-sm"
                        style="width: 100px; height: 100px; object-fit: cover;">
                </div>
    
                <div class="flex-grow-1 my-2">
                    <h4 class="fw-semibold mb-1"><%= hostel.owner.username %></h4>
                    <p class="text-muted mb-3">
                        Joined in <%= new Date(hostel.owner.createdAt).getFullYear() %>
                    </p>
                    <a href="mailto:<%= hostel.owner.email %>" class="btn btn-dark">
                        <%= hostel.owner.email %>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <% } %>